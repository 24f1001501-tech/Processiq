# Secrets - never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Raw data is downloadable from UCI (see README) - not committed.
data/raw/*.csv

# The processed parquet IS committed: the deployed app needs it at runtime,
# and at ~3.6 MB it is well within a sensible repo budget. It is fully
# reproducible from the raw CSVs via `python src/clean_data.py`.
!data/processed/turbine_clean.parquet

# Outputs
outputs/*.html
outputs/*.png

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
